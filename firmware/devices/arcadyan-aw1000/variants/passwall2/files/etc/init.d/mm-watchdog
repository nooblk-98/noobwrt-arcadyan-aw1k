# shellcheck disable=SC2034
USE_PROCD=1
START=99
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/mm-watchdog
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

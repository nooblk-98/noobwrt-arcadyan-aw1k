
config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi'
	option channel '36'
	option band '5g'
	option htmode 'HE80'
	option disabled '0'
	option cell_density '0'
	option country 'LK'
	option txpower '25'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'NoobWRT'
	option encryption 'sae-mixed'
	option key '123456789'
	option time_zone '<+0530>-5:30'
	option time_advertisement '2'
	option multicast_to_unicast_all '1'
	# --- 802.11k/v/r roaming (requires wpad-mbedtls) ---
	option ieee80211k '1'
	option ieee80211v '1'
	option ieee80211r '1'
	option ft_psk_generate_local '1'
	option ft_over_ds '0'
	option mobility_domain 'cafe'
	option wnm_sleep_mode '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi+1'
	option channel '11'
	option band '2g'
	option htmode 'HE20'
	option disabled '0'
	option txpower '25'
	option country 'LK'
	option cell_density '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'NoobWRT'
	option encryption 'sae-mixed'
	option key '123456789'
	option time_zone '<+0530>-5:30'
	option time_advertisement '2'
	option multicast_to_unicast_all '1'
	# --- 802.11k/v/r roaming (requires wpad-mbedtls) ---
	option ieee80211k '1'
	option ieee80211v '1'
	option ieee80211r '1'
	option ft_psk_generate_local '1'
	option ft_over_ds '0'
	option mobility_domain 'cafe'
	option wnm_sleep_mode '0'

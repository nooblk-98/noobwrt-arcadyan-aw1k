#=================================================
# First-boot modem auto-redial
#
# On a cold flash the qmodem dial (S99qmodem_network) can run before the USB
# modem has finished enumerating — the Quectel attaches ttyUSB0..3 ~24s into
# boot. When that race is lost the data link (qmodem section 4_1 -> wwan0_1)
# never comes up and only a manual "redial" in LuCI fixes it.
#
# This runs once on first boot (uci-defaults self-delete) and spawns a detached
# watcher that waits for the modem, then forces ONE redial only if the link is
# still down — so it is a no-op when the boot dial already succeeded.
#=================================================

MODEM_CFG='4_1'

(
	# Wait for the AT serial port to appear (up to ~120s)
	i=0
	while [ ! -e /dev/ttyUSB3 ] && [ "$i" -lt 60 ]; do
		sleep 2
		i=$((i + 1))
	done

	# Give the modem time to register and the boot-time dial to settle
	sleep 20

	# Only redial if the modem data interface is not already up
	if ! ifstatus "$MODEM_CFG" 2>/dev/null | grep -q '"up": true'; then
		logger -t modem-firstboot "data link down after boot — forcing qmodem redial ($MODEM_CFG)"
		/etc/init.d/qmodem_network redial "$MODEM_CFG"
	fi
) >/dev/null 2>&1 &

exit 0

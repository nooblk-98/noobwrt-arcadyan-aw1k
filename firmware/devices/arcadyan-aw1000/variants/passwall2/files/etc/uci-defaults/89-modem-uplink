# One-shot setup of the onboard modem uplink (network.modem, ModemManager).
# Runs on a fresh install and once on an upgrade that keeps /etc/config.
#
# 5gmodem only moves an interface off ModemManager on its own while its
# protocol choice is "auto". The old migration left it on auto, so 5gmodem
# swapped the uplink to qmiraw on first boot and the two fought over the
# modem. Pinning iface_proto=modemmanager here keeps ModemManager in charge.
#=================================================

MODEM_USB='4-1'
# The netifd modemmanager proto matches the physical sysfs path, not the
# /sys/bus/usb/devices symlink. The modem may not have enumerated yet, so fall
# back to the AW1000's known path; 30-modem-devpath corrects it on hotplug.
MODEM_SYSFS='/sys/devices/platform/soc@0/8cf8800.usb/8c00000.usb/xhci-hcd.2.auto/usb4/4-1'

# Carry over the APN and IP type from an older uplink (modem, mmwan, QModem).
_apn=$(uci -q get network.modem.apn)
[ -n "$_apn" ] || _apn=$(uci -q get network.mmwan.apn)
_ipt=$(uci -q get network.modem.iptype)
[ -n "$_ipt" ] || _ipt=$(uci -q get network.modem.pdptype)
[ -n "$_ipt" ] || _ipt=$(uci -q get network.mmwan.iptype)
if [ -f /etc/config/qmodem ]; then
	_first=$(uci -q show qmodem | sed -n 's/^qmodem\.\([^.]*\)=modem-device$/\1/p' | head -n 1)
	[ -n "$_apn" ] || _apn=$(uci -q get "qmodem.$_first.apn")
	[ -n "$_ipt" ] || _ipt=$(uci -q get "qmodem.$_first.pdp_type")
	for _s in $(uci -q show qmodem | sed -n 's/^qmodem\.\([^.]*\)=modem-device$/\1/p'); do
		uci -q delete "network.$_s"
		uci -q delete "network.${_s}v6"
	done
fi

case "$_apn" in
	''|'www.wap.airtel.lk') _apn='internet' ;;
esac
# IPv4-only connects fastest and avoids the dual-stack PDP rejects seen on
# local carriers; a user who set ipv4v6/ipv6 keeps it.
case "$_ipt" in
	ipv4|ipv6|ipv4v6) ;;
	*) _ipt='ipv4' ;;
esac

# QModem and its optional voice/TTL configs are no longer used.
rm -f /etc/config/qmodem /etc/config/qmodem_ttl \
	/etc/config/qmodem_voip /etc/config/qmodem_sip
for _f in /etc/rc.d/S*qmodem* /etc/rc.d/K*qmodem*; do
	[ -e "$_f" ] || [ -L "$_f" ] && rm -f "$_f"
done

# Drop every other uplink on the onboard modem so only one owner remains.
_gone=""
for _if in mmwan 4_1 4_1v6; do
	uci -q get "network.$_if" >/dev/null 2>&1 || continue
	uci -q delete "network.$_if"
	_gone="$_gone $_if"
done
for _if in $(uci -q show network | sed -n "s/^network\.\([^.]*\)\.modem_path='$MODEM_USB'$/\1/p"); do
	[ "$_if" = modem ] && continue
	case "$(uci -q get "network.$_if.proto")" in
		qmi|qmiraw|qmip|mbim|modemmanager)
			uci -q delete "network.$_if"
			_gone="$_gone $_if"
			;;
	esac
done

_dev=$(readlink -f "/sys/bus/usb/devices/$MODEM_USB" 2>/dev/null)
[ -n "$_dev" ] && [ -d "$_dev" ] || _dev="$MODEM_SYSFS"

uci -q get network.modem >/dev/null 2>&1 || uci set network.modem=interface
uci set network.modem.proto='modemmanager'
uci set network.modem.device="$_dev"
uci set network.modem.apn="$_apn"
uci set network.modem.iptype="$_ipt"
[ -n "$(uci -q get network.modem.allowedauth)" ] || uci set network.modem.allowedauth='none'
[ -n "$(uci -q get network.modem.metric)" ] || uci set network.modem.metric='110'
uci set network.modem.modem_path="$MODEM_USB"
# Options of the qmiraw proto that ModemManager does not use.
for _o in devpath pdptype auth disabled; do
	uci -q delete "network.modem.$_o"
done
uci commit network

# Tie the onboard modem to network.modem and pin ModemManager so 5gmodem's
# auto mode never swaps the uplink to another protocol. SMS/USSD go through
# ModemManager too, so nothing else competes with it for the AT ports.
[ -f /etc/config/5gmodem ] || touch /etc/config/5gmodem
_sec="m_$(echo "$MODEM_USB" | sed 's/[^A-Za-z0-9]/_/g')"
uci -q get "5gmodem.$_sec" >/dev/null 2>&1 || {
	uci set "5gmodem.$_sec=modem"
	uci set "5gmodem.$_sec.path=$MODEM_USB"
}
uci set "5gmodem.$_sec.network=modem"
uci set "5gmodem.$_sec.iface_proto=modemmanager"
uci set "5gmodem.$_sec.mm_exclude=0"
uci set "5gmodem.$_sec.apn_mode=manual"
for _5gm in $(uci -q show 5gmodem | sed -n "s/^5gmodem\.\(m_[^.=]*\)\.network='mmwan'$/\1/p"); do
	uci set "5gmodem.$_5gm.network=modem"
done
if uci -q get 5gmodem.@5gmodem[0] >/dev/null 2>&1; then
	uci set 5gmodem.@5gmodem[0].network='modem'
	uci set 5gmodem.@5gmodem[0].iface_proto='modemmanager'
fi
if uci -q get 5gmodem.sms >/dev/null 2>&1; then
	uci set 5gmodem.sms.sms_via_mm='1'
	uci set 5gmodem.sms.ussd_via_mm='1'
fi
uci commit 5gmodem

# Configs from the removed modemdata / SMS-tool / graphical UI stack.
rm -f /etc/config/modemdata /etc/config/defmodems /etc/config/sms_tool_js \
	/etc/config/modemband /etc/config/mm_bandlock

# The WAN firewall zone must include the uplink.
_zone=$(uci -q show firewall 2>/dev/null | sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name='wan'$/\1/p" | head -n 1)
if [ -n "$_zone" ]; then
	for _old in 4_1 4_1v6 wan6 mmwan $_gone; do
		uci -q del_list "firewall.$_zone.network=$_old"
	done
	if ! uci -q get "firewall.$_zone.network" | tr ' ' '\n' | grep -qx 'modem'; then
		uci add_list "firewall.$_zone.network=modem"
	fi
	uci commit firewall
fi

# Point the existing theme toolbar entries at the 5G Modem app.
case "$(uci -q get noobwrt.toolbar_status.url)" in
	"/cgi-bin/luci/admin/modem/modemdata")
		uci set noobwrt.toolbar_status.url='/cgi-bin/luci/admin/status/overview'
		uci commit noobwrt
		;;
esac
case "$(uci -q get noobwrt.toolbar_sms.url)" in
	"/cgi-bin/luci/admin/modem/luci-app-sms-tool-js")
		uci set noobwrt.toolbar_sms.url='/cgi-bin/luci/admin/modem/5gmodem/readsms'
		uci commit noobwrt
		;;
esac
case "$(uci -q get noobwrt.toolbar_modem.url)" in
	"/cgi-bin/luci/admin/modem/qmodem"|"/cgi-bin/luci/admin/modem/bandlock"|"/cgi-bin/luci/admin/modem/modemmanager")
		uci set noobwrt.toolbar_modem.url='/cgi-bin/luci/admin/modem/5gmodem'
		uci commit noobwrt
		;;
esac

# The old MM boot helper is gone from the image; drop any leftover links.
rm -f /etc/rc.d/S*mm-uplink /etc/rc.d/K*mm-uplink

/etc/init.d/dbus enable 2>/dev/null
/etc/init.d/modemmanager enable 2>/dev/null
/etc/init.d/modem-tune enable 2>/dev/null

# Overlay init scripts have no package postinst, so make the first boot work
# even if rcS already built its service list before these symlinks existed.
/etc/init.d/dbus start 2>/dev/null
/etc/init.d/modemmanager start 2>/dev/null
/etc/init.d/modem-tune start >/dev/null 2>&1
exit 0

# Recover the ModemManager uplink if netifd reports it down.
# This is a backup for ModemManager's connection.d disconnect event.
#=================================================

IFACE="mmwan"
INTERVAL=30
FAILS=0

log() {
	logger -t mm-watchdog "$*"
}

while :; do
	sleep "$INTERVAL"

	[ "$(uci -q get "network.$IFACE.disabled")" = "1" ] && continue
	ifstatus "$IFACE" 2>/dev/null | grep -q '"up": true' && {
		FAILS=0
		continue
	}

	# Do not retry while the modem is absent or still initializing.
	mmcli -L 2>/dev/null | grep -q '/Modem/' || continue

	FAILS=$((FAILS + 1))
	if [ "$FAILS" -le 3 ]; then
		log "$IFACE down; ifup attempt $FAILS"
		ifup "$IFACE" >/dev/null 2>&1
		sleep 20
	else
		log "$IFACE still down; backing off"
		sleep 240
		FAILS=0
	fi
done

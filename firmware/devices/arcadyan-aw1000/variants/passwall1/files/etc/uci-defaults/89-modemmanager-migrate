# One-shot migration from QModem to ModemManager.
# Runs on a fresh install and once on an upgrade that keeps /etc/config.
#=================================================

# Preserve the old APN and IP type before removing qmodem.
_apn=$(uci -q get network.mmwan.apn)
_iptype=$(uci -q get network.mmwan.iptype)
if [ -f /etc/config/qmodem ]; then
	_first=$(uci -q show qmodem | sed -n 's/^qmodem\.\([^.]*\)=modem-device$/\1/p' | head -n 1)
	[ -n "$_apn" ] || _apn=$(uci -q get "qmodem.$_first.apn")
	[ -n "$_iptype" ] || _iptype=$(uci -q get "qmodem.$_first.pdp_type")
	for _s in $(uci -q show qmodem | sed -n 's/^qmodem\.\([^.]*\)=modem-device$/\1/p'); do
		uci -q delete "network.$_s"
		uci -q delete "network.${_s}v6"
	done
fi
uci -q delete network.4_1
uci -q delete network.4_1v6
uci -q commit network

[ -n "$_apn" ] || _apn='internet'
case "$_iptype" in
	ipv4|ipv6|ipv4v6) ;;
	*) _iptype='ipv4v6' ;;
esac

# QModem and its optional voice/TTL configs are no longer used.
rm -f /etc/config/qmodem /etc/config/qmodem_ttl \
	/etc/config/qmodem_voip /etc/config/qmodem_sip
for _f in /etc/rc.d/S*qmodem* /etc/rc.d/K*qmodem*; do
	[ -e "$_f" ] || [ -L "$_f" ] && rm -f "$_f"
done

# Find the onboard modem's physical sysfs path. The USB device may not have
# enumerated yet; fall back to the stable port symlink and let mm-uplink
# correct it once ModemManager sees the modem.
_dev=$(readlink -f /sys/bus/usb/devices/4-1 2>/dev/null)
[ -n "$_dev" ] && [ -d "$_dev" ] || _dev="/sys/bus/usb/devices/4-1"

# Create the ModemManager uplink without overwriting an existing APN choice.
uci -q get network.mmwan >/dev/null 2>&1 || uci set network.mmwan=interface
uci set network.mmwan.proto='modemmanager'
uci set network.mmwan.device="$_dev"
uci set network.mmwan.apn="$_apn"
uci set network.mmwan.iptype="$_iptype"
uci set network.mmwan.metric='11'
uci set network.mmwan.force_connection='1'
uci set network.mmwan.signalrate='30'
uci set network.mmwan.init_epsbearer='default'
uci set network.mmwan.disabled='0'
uci commit network

case "$(uci -q get network.mmwan.apn)" in
	''|'www.wap.airtel.lk')
		uci set network.mmwan.apn='internet'
		uci commit network
		;;
esac

# Tie the onboard modem to mmwan. Without this 5gmodem finds no interface for
# 4-1 on first boot, builds its own qmiraw one and inhibits ModemManager, so
# the two fight over the modem on every boot.
_gone=""
uci set network.mmwan.modem_path='4-1'
for _if in $(uci -q show network | sed -n "s/^network\.\([^.]*\)\.modem_path='4-1'$/\1/p"); do
	[ "$_if" = mmwan ] && continue
	case "$(uci -q get "network.$_if.proto")" in
		qmi|qmiraw|mbim)
			uci -q delete "network.$_if"
			_gone="$_gone $_if"
			;;
	esac
done
uci commit network
if [ -f /etc/config/5gmodem ]; then
	uci -q get 5gmodem.m_4_1 >/dev/null 2>&1 || {
		uci set 5gmodem.m_4_1=modem
		uci set 5gmodem.m_4_1.path='4-1'
	}
	uci set 5gmodem.m_4_1.network='mmwan'
	uci set 5gmodem.m_4_1.iface_proto='modemmanager'
	uci set 5gmodem.m_4_1.mm_exclude='0'
	if uci -q get 5gmodem.sms >/dev/null 2>&1; then
		uci set 5gmodem.sms.sms_via_mm='1'
		uci set 5gmodem.sms.ussd_via_mm='1'
	fi
	uci commit 5gmodem
fi

# Do not let 5gmodem auto-replace the pinned APN for this interface.
for _5gm in $(uci -q show 5gmodem 2>/dev/null | sed -n "s/^5gmodem\.\(m_[^.=]*\)\.network='mmwan'$/\1/p"); do
	uci set "5gmodem.$_5gm.apn_mode=manual"
done
uci -q commit 5gmodem 2>/dev/null

# Configs from the removed modemdata / SMS-tool / graphical UI stack.
rm -f /etc/config/modemdata /etc/config/defmodems /etc/config/sms_tool_js \
	/etc/config/modemband /etc/config/mm_bandlock /etc/config/modemmanager

# 5gmodem auto-detects the modem, but pin the uplink for consistency.
if uci -q get 5gmodem.@5gmodem[0] >/dev/null 2>&1; then
	uci set 5gmodem.@5gmodem[0].network='mmwan'
	uci set 5gmodem.@5gmodem[0].iface_proto='modemmanager'
	uci commit 5gmodem
fi

# The WAN firewall zone must include the new uplink.
_zone=$(uci -q show firewall 2>/dev/null | sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name='wan'$/\1/p" | head -n 1)
if [ -n "$_zone" ]; then
	for _old in 4_1 4_1v6 wan6 $_gone; do
		uci -q del_list "firewall.$_zone.network=$_old"
	done
	if ! uci -q get "firewall.$_zone.network" | tr ' ' '\n' | grep -qx 'mmwan'; then
		uci add_list "firewall.$_zone.network=mmwan"
	fi
	uci commit firewall
fi

# Point the existing theme toolbar entries at the 5G Modem app.
case "$(uci -q get noobwrt.toolbar_status.url)" in
	"/cgi-bin/luci/admin/modem/modemdata")
		uci set noobwrt.toolbar_status.url='/cgi-bin/luci/admin/status/overview'
		uci commit noobwrt
		;;
esac
case "$(uci -q get noobwrt.toolbar_sms.url)" in
	"/cgi-bin/luci/admin/modem/luci-app-sms-tool-js")
		uci set noobwrt.toolbar_sms.url='/cgi-bin/luci/admin/modem/5gmodem/readsms'
		uci commit noobwrt
		;;
esac
case "$(uci -q get noobwrt.toolbar_modem.url)" in
	"/cgi-bin/luci/admin/modem/qmodem"|"/cgi-bin/luci/admin/modem/bandlock"|"/cgi-bin/luci/admin/modem/modemmanager"|"/cgi-bin/luci/admin/modem/5gmodem")
		uci set noobwrt.toolbar_modem.url='/cgi-bin/luci/admin/modem/5gmodem'
		uci commit noobwrt
		;;
esac

/etc/init.d/dbus enable 2>/dev/null
/etc/init.d/modemmanager enable 2>/dev/null
/etc/init.d/mm-uplink enable 2>/dev/null

# Overlay init scripts have no package postinst, so make the first boot work
# even if rcS already built its service list before these symlinks existed.
/etc/init.d/dbus start 2>/dev/null
/etc/init.d/modemmanager start 2>/dev/null
/etc/init.d/mm-uplink start >/dev/null 2>&1 &
exit 0

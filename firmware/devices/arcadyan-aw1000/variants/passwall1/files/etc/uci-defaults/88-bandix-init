# Configure Bandix Traffic Monitor to monitor WAN (wwan0) interface.

uci set bandix.general.iface='br-lan'
uci set bandix.traffic.enabled='1'
uci set bandix.traffic.speed_unit='bytes'
uci set bandix.traffic.offline_timeout='120'
uci set bandix.traffic.traffic_realtime_window='600'
uci set bandix.traffic.traffic_flush_interval='600'
uci set bandix.traffic.traffic_enable_storage='1'
uci set bandix.connections.enabled='1'
uci commit bandix

/etc/init.d/bandix restart 2>/dev/null || true

exit 0

#!/bin/sh

chmod +x /usr/libexec/ipt_ttl.sh

rm -f /etc/nftables.d/10-custom-filter-chains.nft
cat <<EOF > /etc/nftables.d/10-custom-filter-chains.nft
# Custom TTL / HL nftables
chain mangle_prerouting_ttl64 {
  type filter hook prerouting priority 300; policy accept;
  counter ip ttl set 64
}

chain mangle_postrouting_ttl64 {
  type filter hook postrouting priority 300; policy accept;
  counter ip ttl set 64
}

chain mangle_prerouting_hoplimit64 {
  type filter hook prerouting priority 300; policy accept;
  iifname "wwan0" counter ip6 hoplimit set 64
  iifname "wwan0_1" counter ip6 hoplimit set 64
}

chain mangle_postrouting_hoplimit64 {
  type filter hook postrouting priority 300; policy accept;
  oifname "wwan0" counter ip6 hoplimit set 64
  oifname "wwan0_1" counter ip6 hoplimit set 64
}

EOF
sleep 1

cat <<EOF > /root/ttl2
nft add rule inet mangle_prerouting ip ttl set 64
nft add rule inet mangle_postrouting ip ttl set 64
nft add rule inet mangle_prerouting iifname "wwan0_1" ip6 hoplimit set 64
nft add rule inet mangle_prerouting iifname "wwan0" ip6 hoplimit set 64
nft add rule inet mangle_postrouting oifname "wwan0_1" ip6 hoplimit set 64
nft add rule inet mangle_postrouting oifname "wwan0" ip6 hoplimit set 64

EOF
sleep 1

/etc/init.d/firewall reload 2>/dev/null

exit 0
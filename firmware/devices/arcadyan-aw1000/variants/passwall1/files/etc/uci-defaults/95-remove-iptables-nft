# Remove iptables-nft at first boot.
# It gets pulled in as a dependency despite being excluded at build time.
# Removing it prevents legacy iptables rules from mixing with nftables (fw4).

if command -v apk > /dev/null 2>&1; then
    apk del --force iptables-nft 2>/dev/null || true
else
    opkg remove --force-depends iptables-nft 2>/dev/null || true
fi

exit 0
